---
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import DifficultyBadge from '../../components/destinos/DifficultyBadge.astro';
import DestinationCard from '../../components/destinos/DestinationCard.astro';
import Icon from '../../components/ui/Icon.astro';
import Prose from '../../components/ui/Prose.astro';
import Tag from '../../components/ui/Tag.astro';
import { site } from '../../data/site';
import { difficultyMeta, formatMonths, getDestinos, getRutas } from '../../lib/content';
import { whatsappLink } from '../../lib/utils';

export async function getStaticPaths() {
	const destinos = await getDestinos();
	return destinos.map((destino) => ({
		params: { slug: destino.id },
		props: { destino },
	}));
}

const { destino } = Astro.props;
const { data } = destino;
const { Content } = await render(destino);

const rutas = await getRutas();
const ruta = rutas.find((item) => item.data.destination === destino.id);

const destinos = await getDestinos();
const related = destinos
	.filter((item) => item.id !== destino.id)
	.map((item) => ({
		item,
		shared: item.data.categories.filter((category) => data.categories.includes(category)).length,
	}))
	.sort((a, b) => b.shared - a.shared || a.item.data.order - b.item.data.order)
	.slice(0, 3)
	.map(({ item }) => item);

const difficulty = difficultyMeta[data.difficulty];

const facts = [
	{ label: 'Dificultad', value: difficulty.label, icon: 'mountain' as const },
	{ label: 'Duración', value: `${data.durationDays} ${data.durationDays === 1 ? 'día' : 'días'}`, icon: 'clock' as const },
	...(data.hikeDistanceKm
		? [{ label: 'Distancia', value: `${data.hikeDistanceKm} km`, icon: 'route' as const }]
		: []),
	...(data.elevationGainM
		? [{ label: 'Desnivel', value: `+${data.elevationGainM} m`, icon: 'altitude' as const }]
		: []),
	...(data.altitudeMasl
		? [{ label: 'Altitud', value: `${data.altitudeMasl} m s. n. m.`, icon: 'pin' as const }]
		: []),
];

const reserveLink = whatsappLink(
	`Hola, quiero información para visitar ${data.title} (${data.region}). ¿Me ayudan a planear la salida?`,
	site.whatsapp,
);

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'TouristDestination',
		name: data.title,
		description: data.summary,
		url: `${site.url}/destinos/${destino.id}`,
		image: new URL(data.heroImage.src, site.url).href,
		touristType: data.categories,
		geo: {
			'@type': 'GeoCoordinates',
			latitude: data.coordinates.lat,
			longitude: data.coordinates.lng,
		},
		address: {
			'@type': 'PostalAddress',
			addressLocality: data.municipality,
			addressRegion: 'Antioquia',
			addressCountry: 'CO',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
			{ '@type': 'ListItem', position: 2, name: 'Destinos', item: `${site.url}/destinos` },
			{ '@type': 'ListItem', position: 3, name: data.title },
		],
	},
];
---

<Layout title={data.title} description={data.summary} image={new URL(data.heroImage.src, site.url).href} type="article" schema={schema}>
	<article>
		<header class="container-page pt-8 md:pt-12">
			<Breadcrumbs
				items={[
					{ label: 'Inicio', href: '/' },
					{ label: 'Destinos', href: '/destinos' },
					{ label: data.title },
				]}
			/>

			<div class="mt-8 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-14">
				<div>
					<div class="flex flex-wrap gap-2">
						{data.categories.map((category) => <Tag category={category} />)}
					</div>
					<h1 class="mt-5 text-h1 font-medium text-ink">{data.title}</h1>
					<p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-small font-semibold uppercase tracking-[0.1em] text-accent">
						<span>{data.region}</span>
						<span class="size-1 rounded-full bg-accent/50"></span>
						<span>{data.municipality}</span>
					</p>
					<p class="mt-5 max-w-xl text-lead text-muted">{data.summary}</p>

					<div class="mt-8 flex flex-wrap gap-3">
						<Button href={reserveLink} target="_blank" rel="noopener noreferrer" icon="whatsapp" iconPosition="left">
							Planear esta salida
						</Button>
						<Button href="#informacion" variant="secondary">Ver detalles prácticos</Button>
					</div>
				</div>

				<div class="relative">
					<div class="overflow-hidden rounded-organic border border-line/60">
						<Picture
							src={data.heroImage}
							alt={data.heroAlt}
							formats={['avif', 'webp']}
							widths={[600, 900, 1200]}
							sizes="(min-width: 1024px) 46vw, 100vw"
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="aspect-[4/3] w-full object-cover sm:aspect-[16/11] lg:aspect-[4/5]"
						/>
					</div>
					<div class="absolute -bottom-4 left-4 rounded-2xl border border-line bg-panel/95 px-5 py-3 shadow-lift backdrop-blur">
						<p class="text-[0.62rem] font-bold uppercase tracking-[0.14em] text-muted">Mejor época</p>
						<p class="mt-1 font-display text-lg leading-none text-ink">{formatMonths(data.bestMonths)}</p>
					</div>
				</div>
			</div>
		</header>

		<section class="container-page mt-16 md:mt-20">
			<dl class="grid grid-cols-2 gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-3 lg:grid-cols-5">
				{
					facts.map((fact) => (
						<div class="flex flex-col gap-2 bg-panel p-4 md:p-5">
							<dt class="flex items-center gap-1.5 text-[0.65rem] font-bold uppercase tracking-[0.12em] text-muted">
								<Icon name={fact.icon} size={13} class="text-brand" />
								{fact.label}
							</dt>
							<dd class="font-display text-lg leading-tight text-ink">{fact.value}</dd>
						</div>
					))
				}
			</dl>
		</section>

		<section id="informacion" class="container-page mt-16 grid gap-12 py-4 md:mt-20 lg:grid-cols-[1fr_22rem] lg:gap-16">
			<div>
				<div class="flex items-center gap-3">
					<span class="h-px w-10 bg-accent"></span>
					<p class="eyebrow text-accent">La ficha</p>
				</div>
				<h2 class="mt-4 text-h2 font-medium text-ink">Qué vas a encontrar</h2>

				<div class="mt-8">
					<Prose>
						<Content />
					</Prose>
				</div>

				<div class="mt-10 flex items-start gap-3 rounded-card border border-line/80 bg-surface/60 p-5">
					<Icon name="shield" size={20} class="mt-0.5 shrink-0 text-brand" />
					<div>
						<h2 class="font-display text-lg font-semibold text-ink">Accesibilidad</h2>
						<p class="mt-1 text-small text-muted">{data.accessibilityNotes}</p>
					</div>
				</div>

				<section class="mt-12" aria-labelledby="imperdibles">
					<h2 id="imperdibles" class="text-h3 font-medium text-ink">Lo imperdible</h2>
					<ul class="mt-5 grid gap-3 sm:grid-cols-2">
						{
							data.highlights.map((highlight) => (
								<li class="flex gap-3 rounded-card border border-line/70 bg-panel p-4">
									<Icon name="check" size={18} class="mt-0.5 shrink-0 text-brand" />
									<span class="text-small text-ink">{highlight}</span>
								</li>
							))
						}
					</ul>
				</section>

				<section class="mt-12" aria-labelledby="consejos">
					<h2 id="consejos" class="text-h3 font-medium text-ink">Antes de salir</h2>
					<ol class="mt-5 space-y-3">
						{
							data.tips.map((tip, index) => (
								<li class="flex gap-4 border-b border-line/70 pb-3 last:border-0">
									<span class="grid size-7 shrink-0 place-items-center rounded-full bg-accent-soft font-display text-sm font-semibold text-accent">
										{index + 1}
									</span>
									<span class="text-small text-muted">{tip}</span>
								</li>
							))
						}
					</ol>
				</section>

				{
					data.gallery.length > 0 && (
						<section class="mt-12" aria-labelledby="galeria-destino">
							<h2 id="galeria-destino" class="text-h3 font-medium text-ink">
								Imágenes del lugar
							</h2>
							<div class="mt-5 grid gap-3 sm:grid-cols-2">
								{data.gallery.map((photo, index) => (
									<figure class="group relative overflow-hidden rounded-card bg-surface">
										<Picture
											src={photo.src}
											alt={photo.alt}
											formats={['avif', 'webp']}
											widths={[480, 720, 1080]}
											sizes="(min-width: 640px) 50vw, 100vw"
											loading="lazy"
											decoding="async"
											class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
										/>
										{photo.caption && (
											<figcaption class="border-t border-line/70 bg-panel px-4 py-3 text-[0.78rem] text-muted">
												{photo.caption}
											</figcaption>
										)}
									</figure>
								))}
							</div>
							<p class="mt-3 text-right text-[0.72rem] text-muted">
								Fotografías con licencia Creative Commons · ver <a href="/creditos" class="underline">créditos</a>.
							</p>
						</section>
					)
				}
			</div>

			<div class="lg:sticky lg:top-24 lg:self-start">
				<div class="rounded-panel border border-line/80 bg-panel p-6 shadow-soft">
					<p class="eyebrow text-accent">Resumen práctico</p>
					<dl class="mt-5 space-y-4">
						<div>
							<dt class="flex items-center gap-2 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-muted">
								<Icon name="mountain" size={15} class="shrink-0 text-brand" />
								Dificultad
							</dt>
							<dd class="mt-1">
								<DifficultyBadge difficulty={data.difficulty} />
								<p class="mt-1 text-[0.75rem] text-muted">{difficulty.description}</p>
							</dd>
						</div>
						<div>
							<dt class="flex items-center gap-2 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-muted">
								<Icon name="calendar" size={15} class="shrink-0 text-brand" />
								Meses recomendados
							</dt>
							<dd class="mt-1 text-small text-ink">{formatMonths(data.bestMonths)}</dd>
						</div>
						<div>
							<dt class="flex items-center gap-2 text-[0.65rem] font-bold uppercase tracking-[0.1em] text-muted">
								<Icon name="pin" size={15} class="shrink-0 text-brand" />
								Coordenadas
							</dt>
							<dd class="mt-1 text-small tabular-nums text-ink">
								{data.coordinates.lat.toFixed(4)}, {data.coordinates.lng.toFixed(4)}
								<a
									href={`https://www.google.com/maps/search/?api=1&query=${data.coordinates.lat},${data.coordinates.lng}`}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-1.5 flex items-center gap-1 text-[0.75rem] font-semibold text-brand hover:underline"
								>
									Cómo llegar
									<Icon name="arrow-up-right" size={13} />
								</a>
							</dd>
						</div>
					</dl>

					<div class="mt-6 border-t border-line/70 pt-5">
						<Button href={reserveLink} target="_blank" rel="noopener noreferrer" class="w-full" icon="whatsapp" iconPosition="left">
							Consultar disponibilidad
						</Button>
						<a
							href={`/contacto?destino=${encodeURIComponent(data.title)}`}
							class="mt-2.5 flex h-11 w-full items-center justify-center gap-2 rounded-full border border-brand/30 text-small font-semibold text-brand transition-colors hover:border-brand hover:bg-brand/5"
						>
							<Icon name="mail" size={16} />
							Prefiero el formulario
						</a>
						<p class="mt-3 text-center text-[0.7rem] leading-relaxed text-muted">
							Atención de lunes a sábado, 8:00 a 18:00.
						</p>
					</div>
				</div>

				{
					ruta && (
						<div class="mt-4 rounded-panel border border-brand/25 bg-brand/5 p-6">
							<p class="eyebrow text-brand">Itinerario sugerido</p>
							<h2 class="mt-2 font-display text-xl font-medium text-ink">{ruta.data.title}</h2>
							<p class="mt-2 text-small text-muted">
								{ruta.data.durationDays} días · {ruta.data.distanceKm} km · {difficultyMeta[ruta.data.difficulty].label}
							</p>
							<a
								href={`/rutas#${ruta.id}`}
								class="mt-4 inline-flex items-center gap-2 text-small font-bold text-brand hover:underline"
							>
								Ver el itinerario día por día
								<Icon name="arrow-right" size={15} />
							</a>
						</div>
					)
				}
			</div>
		</section>

		{
			related.length > 0 && (
				<section class="border-t border-line/70 bg-surface/40">
					<div class="container-page py-section">
						<div class="flex flex-wrap items-end justify-between gap-4">
							<div>
								<p class="eyebrow text-accent">Sigue explorando</p>
								<h2 class="mt-3 text-h2 font-medium text-ink">Otros destinos cerca</h2>
							</div>
							<Button href="/destinos" variant="secondary" icon="arrow-right">Ver todos</Button>
						</div>
						<div class="mt-8 grid gap-5 md:grid-cols-3">
							{related.map((item) => (
								<DestinationCard destino={item} sizes="(min-width: 768px) 33vw, 100vw" />
							))}
						</div>
					</div>
				</section>
			)
		}
	</article>
</Layout>
