---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { getDestinos } from '../lib/content';

const destinos = (await getDestinos()).slice(0, 3);

const links = [
	{
		href: '/destinos',
		label: 'Destinos',
		text: 'Siete lugares con dificultad, temporada y accesibilidad.',
		icon: 'pin' as const,
	},
	{
		href: '/rutas',
		label: 'Rutas',
		text: 'Itinerarios día por día y un mapa ilustrado del departamento.',
		icon: 'route' as const,
	},
	{
		href: '/galeria',
		label: 'Galería',
		text: 'Veintisiete fotografías de paisaje, agua, fauna y cultura.',
		icon: 'camera' as const,
	},
	{
		href: '/contacto',
		label: 'Contacto',
		text: 'Cuéntanos qué quieres ver y armamos una propuesta.',
		icon: 'mail' as const,
	},
];
---

<Layout
	title="Página no encontrada"
	description="La página que buscas no existe o cambió de lugar. Explora los destinos, las rutas y la galería de Antioquia Silvestre."
	noindex={true}
>
	<section class="container-page py-16 md:py-24">
		<div class="mx-auto max-w-3xl text-center">
			<svg
				class="mx-auto h-24 w-auto text-brand/35 md:h-28"
				viewBox="0 0 240 100"
				role="presentation"
				aria-hidden="true"
				focusable="false"
			>
				<text
					x="120"
					y="80"
					text-anchor="middle"
					font-family="Fraunces Variable, Georgia, serif"
					font-size="96"
					font-weight="500"
					letter-spacing="-4"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
				>404</text>
			</svg>
			<p class="eyebrow mt-2 text-accent">Te saliste del sendero</p>
			<h1 class="mt-3 text-h1 font-medium text-ink">Esta página no existe.</h1>
			<p class="mx-auto mt-4 max-w-lg text-body text-muted">
				Puede que el enlace esté viejo o que hayamos movido el contenido. Vuelve al inicio o sigue
				por alguno de estos caminos.
			</p>

			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<Button href="/" icon="arrow-right">Volver al inicio</Button>
				<Button href="/destinos" variant="secondary">Ver destinos</Button>
			</div>
		</div>

		<div class="mx-auto mt-16 grid max-w-4xl gap-3 sm:grid-cols-2">
			{
				links.map((link) => (
					<a
						href={link.href}
						class="group flex items-start gap-4 rounded-card border border-line/80 bg-panel p-5 transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-brand/40"
					>
						<span class="grid size-10 shrink-0 place-items-center rounded-full bg-brand/10 text-brand">
							<Icon name={link.icon} size={18} />
						</span>
						<span class="min-w-0">
							<span class="block font-display text-lg font-semibold text-ink group-hover:text-brand">
								{link.label}
							</span>
							<span class="mt-0.5 block text-small text-muted">{link.text}</span>
						</span>
						<Icon name="arrow-up-right" size={16} class="ml-auto mt-1 shrink-0 text-muted" />
					</a>
				))
			}
		</div>

		<div class="mx-auto mt-14 max-w-4xl border-t border-line/70 pt-8">
			<p class="eyebrow text-accent">O empieza por aquí</p>
			<ul class="mt-4 flex flex-wrap gap-2">
				{
					destinos.map((destino) => (
						<li>
							<a
								href={`/destinos/${destino.id}`}
								class="inline-flex items-center gap-2 rounded-full border border-line bg-panel px-3.5 py-2 text-[0.8rem] font-semibold text-ink transition-colors hover:border-brand hover:text-brand"
							>
								<span class="size-1.5 rounded-full bg-accent" />
								{destino.data.title}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
