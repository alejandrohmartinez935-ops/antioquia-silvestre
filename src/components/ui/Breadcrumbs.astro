---
import Icon from './Icon.astro';

interface Props {
	items: Array<{ label: string; href?: string }>;
}

const { items } = Astro.props;
---

<nav aria-label="Ruta de navegación">
	<ol class="flex flex-wrap items-center gap-2 text-[0.72rem] font-semibold uppercase tracking-[0.1em] text-muted">
		{
			items.map((item, index) => (
				<li class="flex items-center gap-2">
					{item.href ? (
						<a href={item.href} class="transition-colors hover:text-brand">
							{item.label}
						</a>
					) : (
						<span aria-current="page" class="text-ink">
							{item.label}
						</span>
					)}
					{index < items.length - 1 && <Icon name="chevron-down" size={12} class="-rotate-90 opacity-60" />}
				</li>
			))
		}
	</ol>
</nav>
