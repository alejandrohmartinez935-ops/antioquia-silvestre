---
import { filledIcons, icons, type IconName } from '../../lib/icons';
import { cn } from '../../lib/utils';

interface Props {
	name: IconName;
	class?: string;
	size?: number;
	strokeWidth?: number;
	label?: string;
}

const { name, class: className, size = 24, strokeWidth = 1.75, label } = Astro.props;
const isFilled = filledIcons.includes(name);
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width={isFilled ? undefined : strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={cn('shrink-0', className)}
	aria-hidden={label ? undefined : 'true'}
	role={label ? 'img' : undefined}
	focusable="false"
>
	{label && <title>{label}</title>}
	<Fragment set:html={icons[name]} />
</svg>
