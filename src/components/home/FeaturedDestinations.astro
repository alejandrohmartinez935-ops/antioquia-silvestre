---
import type { Destino } from '../../lib/content';
import DestinationCard from '../destinos/DestinationCard.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
	destinos: Destino[];
}

const { destinos } = Astro.props;
const [main, ...rest] = destinos;
---

<section id="destacados" class="container-page py-section">
	<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
		<SectionHeading
			eyebrow="Destinos destacados"
			title="Cinco lugares para empezar"
			intro="Una selección para quien llega por primera vez: agua, montaña, pueblos y aves, sin cruzar el departamento de lado a lado."
		/>
		<Button href="/destinos" variant="secondary" icon="arrow-right" class="shrink-0">
			Ver los 7 destinos
		</Button>
	</div>

	<div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
		{
			main && (
				<DestinationCard
					destino={main}
					variant="feature"
					class="reveal md:col-span-2 lg:row-span-2"
					sizes="(min-width: 1024px) 50vw, 100vw"
					loading="eager"
				/>
			)
		}
		{
			rest.map((destino) => (
				<DestinationCard
					destino={destino}
					class="reveal"
					sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
					loading="lazy"
				/>
			))
		}
	</div>
</section>
