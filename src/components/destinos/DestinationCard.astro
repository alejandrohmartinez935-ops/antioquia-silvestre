---
import { Picture } from 'astro:assets';
import { categoryBySlug } from '../../data/site';
import { difficultyMeta, formatMonths, type Destino } from '../../lib/content';
import { cn } from '../../lib/utils';
import Icon from '../ui/Icon.astro';
import Tag from '../ui/Tag.astro';

interface Props {
	destino: Destino;
	variant?: 'default' | 'overlay' | 'wide' | 'feature';
	class?: string;
	loading?: 'eager' | 'lazy';
	sizes?: string;
}

const {
	destino,
	variant = 'default',
	class: className,
	loading = 'lazy',
	sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props;

const { data } = destino;
const difficulty = difficultyMeta[data.difficulty];
const href = `/destinos/${destino.id}`;
const isFeature = variant === 'feature';
const isOverlay = variant === 'overlay' || isFeature;
const firstCategory = categoryBySlug(data.categories[0]);
---

<article
	data-destination={destino.id}
	class={cn(
		'group relative isolate overflow-hidden rounded-card border border-line/70 bg-panel shadow-soft transition-[transform,box-shadow] duration-300 ease-out-soft hover:-translate-y-1 hover:shadow-lift',
		isFeature && 'h-full',
		className,
	)}
	data-categories={data.categories.join(' ')}
>
	<div
		class={cn(
			'relative overflow-hidden',
			isFeature
				? 'h-full min-h-[24rem] md:min-h-[30rem]'
				: isOverlay
					? 'aspect-[4/5]'
					: variant === 'wide'
						? 'aspect-[16/10]'
						: 'aspect-[4/3]',
		)}
	>
		<Picture
			src={data.heroImage}
			alt={data.heroAlt}
			formats={['avif', 'webp']}
			widths={isFeature ? [800, 1200, 1600] : isOverlay ? [600, 900, 1200] : [480, 720, 1080]}

			sizes={sizes}
			loading={loading}
			decoding="async"
			class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
		/>
		<div
			class={cn(
				'absolute inset-0',
				isOverlay
					? 'bg-gradient-to-t from-[#07120d]/95 via-[#07120d]/35 to-transparent'
					: 'bg-gradient-to-t from-[#07120d]/15 to-transparent',
			)}
		>
		</div>

		<div class="absolute left-3 top-3 z-20 flex flex-wrap gap-1.5">
			{data.categories.slice(0, isOverlay ? 2 : 1).map((categoria) => <Tag category={categoria} />)}
		</div>

		{isOverlay && (
			<div class="absolute inset-x-0 bottom-0 z-20 p-5 text-[#f7f5ee] md:p-6">
				<p class="mb-1 text-[0.7rem] font-bold uppercase tracking-[0.16em] text-[#8fc7a8]">
					{data.region}
				</p>
				<h3 class="font-display text-3xl font-medium tracking-tight">{data.title}</h3>
				<p class="mt-2 line-clamp-2 text-sm text-[#f7f5ee]/80">{data.summary}</p>
				<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[#f7f5ee]/85">
					<span class="inline-flex items-center gap-1.5">
						<Icon name="clock" size={14} />
						{data.durationDays} {data.durationDays === 1 ? 'día' : 'días'}
					</span>
					<span class="inline-flex items-center gap-1.5">
						<span class={cn('size-1.5 rounded-full', difficulty.dot)}></span>
						{difficulty.label}
					</span>
					<span class="inline-flex items-center gap-1.5">
						<Icon name={firstCategory?.icon ?? 'mountain'} size={14} />
						{firstCategory?.short}
					</span>
				</div>
			</div>
		)}
	</div>

	{!isOverlay && (
		<div class="relative z-20 flex flex-col gap-3 p-5">
			<div class="flex items-start justify-between gap-3">
				<div>
					<p class="text-[0.68rem] font-bold uppercase tracking-[0.14em] text-accent">{data.region}</p>
					<h3 class="mt-1 font-display text-2xl font-medium tracking-tight text-ink">
						{data.title}
					</h3>
				</div>
				<span class="mt-1 grid size-9 place-items-center rounded-full border border-line/70 text-muted transition-colors group-hover:border-brand group-hover:bg-brand group-hover:text-on-brand">
					<Icon name="arrow-up-right" size={16} />
				</span>
			</div>
			<p class="line-clamp-2 text-small text-muted">{data.summary}</p>
			<div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line/60 pt-3 text-xs text-muted">
				<span class="inline-flex items-center gap-1.5">
					<Icon name="clock" size={14} />
					{data.durationDays} {data.durationDays === 1 ? 'día' : 'días'}
				</span>
				<span class={cn('inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 font-semibold', difficulty.style)}>
					{difficulty.label}
				</span>
				<span class="inline-flex items-center gap-1.5">
					<Icon name="calendar" size={14} />
					{formatMonths(data.bestMonths.slice(0, 2))}
				</span>
			</div>
		</div>
	)}

	<a href={href} class="absolute inset-0 z-30 rounded-card focus-visible:outline-2 focus-visible:outline-offset-4" aria-label={`Ver el destino ${data.title}`}>
		<span class="sr-only">Ver {data.title}</span>
	</a>
</article>
