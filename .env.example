# Variables de entorno de Antioquia Silvestre
# Copia este archivo como .env y ajusta los valores.

# URL pública del sitio (se usa en sitemap, canonical y Open Graph).
PUBLIC_SITE_URL=https://antioquiasilvestre.co

# Número de WhatsApp en formato internacional, sin + ni espacios.
PUBLIC_WHATSAPP_NUMBER=573001234567

# Correo de contacto visible en el sitio.
PUBLIC_CONTACT_EMAIL=hola@antioquiasilvestre.co

# Envío del formulario con Resend (opcional).
# Sin RESEND_API_KEY y CONTACT_TO_EMAIL el formulario muestra el fallback de WhatsApp.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Antioquia Silvestre <onboarding@resend.dev>"
